# Template for ~/.hermes/profiles/<agent>/.env  (one real file per agent, never committed)

# Model provider key. Already present if the profile was created with --clone.
OPENROUTER_API_KEY=

# From @BotFather. One token per agent, never shared between profiles.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (from @userinfobot). Comma-separate for two teammates.
TELEGRAM_ALLOWED_USERS=

# Numeric ID of the team group (negative number). Authorises every member of that
# group, which is what lets the peer bots be accepted as senders.
TELEGRAM_GROUP_ALLOWED_CHATS=

# Accept messages written by other bots, but only when they @mention this bot.
TELEGRAM_ALLOW_BOTS=mentions
TELEGRAM_BOTS_REQUIRE_MENTION=true
